{
  "name": "Cami · HaCAithon 2026",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Aplicación",
      "onAutoForward": "openPreview"
    }
  },
  "postAttachCommand": {
    "app": "cd interlude && npm run dev -- --hostname 0.0.0.0"
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    }
  },
  "postCreateCommand": "cd interlude && npm install",
  "//": "El panel lee las llamadas desde Supabase y necesita sus claves en interlude/.env.local"
}
